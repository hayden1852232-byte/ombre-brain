# 涂鸦云项目（iot.tuya.com → 云开发 → 你的项目 → 概览）
ACCESS_ID=
ACCESS_SECRET=
TUYA_ENDPOINT=https://openapi.tuyacn.com

# 项目 → 设备 → 全部设备
INFRARED_ID=     # smart ir / 红外转发器 的设备 ID
REMOTE_ID=       # DIY 遥控器 的设备 ID

# 跑 python list_codes.py 得到的四个学习码
CODE_POWER=
CODE_PAT=
CODE_SLOW=
CODE_QUICK=

# 公网路径，强烈建议换成随机串，例：/hs-8f3k2q9x/mcp
MCP_PATH=/mcp
HOST=127.0.0.1
PORT=8765
